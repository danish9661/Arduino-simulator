      "content": "from machine import Pin\nfrom time import sleep_ms\n\nprint(\"MP_MIX_BOOT\")\nled = Pin(16, Pin.OUT, value=0)\nservo = Pin(15, Pin.OUT, value=0)\nneo = Pin(2, Pin.OUT, value=0)\nsda = Pin(4, Pin.OUT, value=0)\nscl = Pin(5, Pin.OUT, value=0)\n\nfor i in range(8):\n    if i % 2 == 0:\n        led.on()\n        servo.on()\n        neo.on()\n        sda.on()\n        scl.off()\n    else:\n        led.off()\n        servo.off()\n        neo.off()\n        sda.off()\n        scl.on()\n    print(\"MP_MIX_STEP\", i)\n    sleep_ms(30)\n\nprint(\"MP_MIX_DONE\")\n",
