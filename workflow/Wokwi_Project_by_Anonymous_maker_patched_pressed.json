      "id": "project/uno1/sketch.ino",
      "path": "project/uno1/sketch.ino",
      "name": "sketch.ino",
      "kind": "code",
      "boardId": "uno1",
      "boardKind": "arduino_uno",
      "content": "int ledb = 12;\nint ledm = 13;\n\nint btnb = 11;\nint btnm = 10;\n\nint btnstateb = 0;\nint btnstatem = 0;\n\nvoid setup()  {\n  pinMode(ledb, OUTPUT);\n  pinMode(ledm, OUTPUT);\n  pinMode(btnb, INPUT_PULLUP);\n  pinMode(btnm, INPUT_PULLUP);\n}\n\nvoid loop() {\n  btnstateb = digitalRead(btnb);\n  btnstatem =digitalRead(btnm);\n  if(btnstateb == LOW) {\n    digitalWrite(ledb, HIGH);\n  }\n  else{\n    digitalWrite(ledb, LOW);\n  }\n  if(btnstatem == LOW){\n    digitalWrite(ledm, HIGH);\n  }\n  else{\n    digitalWrite(ledm, LOW);\n  }\n}\n"
    }
