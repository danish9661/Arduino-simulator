      "boardKind": "arduino_uno",
      "content": "// autocoding for stepper_motor_1 start\n// Stepper setup with A4988 (Step=8, Dir=9)\n#include <AccelStepper.h>\nAccelStepper stepper(AccelStepper::DRIVER, 8, 9);\n// autocoding for stepper_motor_1 end\n\n// autocoding for stepper_motor_2 start\n// Stepper setup with A4988 (Step=8, Dir=9)\n#include <AccelStepper.h>\nAccelStepper stepper(AccelStepper::DRIVER, 8, 9);\n// autocoding for stepper_motor_2 end\n\nvoid setup() {\n  // autocoding for stepper_motor_2 start\n  pinMode(10, OUTPUT);\n    digitalWrite(10, LOW);\n    stepper.setMaxSpeed(1000);\n    stepper.setAcceleration(500);\n  // autocoding for stepper_motor_2 end\n\n  // autocoding for stepper_motor_1 start\n  pinMode(10, OUTPUT);\n    digitalWrite(10, LOW);\n    stepper.setMaxSpeed(1000);\n    stepper.setAcceleration(500);\n  // autocoding for stepper_motor_1 end\n}\n\nvoid loop() {\n  // autocoding for stepper_motor_2 start\n  if (stepper.distanceToGo() == 0) {\n    stepper.moveTo(-stepper.currentPosition());\n    delay(1000);\n  }\n  stepper.run();\n  // autocoding for stepper_motor_2 end\n\n  // autocoding for stepper_motor_1 start\n  if (stepper.distanceToGo() == 0) {\n    stepper.moveTo(-stepper.currentPosition());\n    delay(1000);\n  }\n  stepper.run();\n  // autocoding for stepper_motor_1 end\n}\n",
