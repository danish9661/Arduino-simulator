{
  "name": "openhw-studio-cli-danish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Terminal CLI for OpenHW Studio simulation workflows",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/cli.ts mcp serve",
    "typecheck": "tsc --noEmit",
    "test:mcp:smoke": "node scripts/mcp-smoke.mjs",
