    { "id": "MOSI", "x": 130, "y": 20, "type": "digital", "description": "SPI master-out" },
    { "id": "MISO", "x": 130, "y": 34, "type": "digital", "description": "SPI master-in" },
    { "id": "SCK", "x": 130, "y": 48, "type": "digital", "description": "SPI clock" },
    { "id": "CSN", "x": 130, "y": 62, "type": "digital", "description": "Active-low chip select" },
    { "id": "GDO0", "x": 70, "y": 10, "type": "digital", "description": "IRQ/status output 0" },
    { "id": "GDO2", "x": 90, "y": 10, "type": "digital", "description": "IRQ/status output 2" }
