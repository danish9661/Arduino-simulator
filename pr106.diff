+        color: disabled ? 'var(--text3)' : (color ? (isInteractive ? '#fff' : color) : 'var(--text)'),
+        padding: iconOnly ? '7px 10px' : '7px 14px', borderRadius: 8,
+        fontFamily: 'Space Grotesk, sans-serif', fontSize: 13,
